---
/**
 * Hero "instrument panel": one trace per featured category, all scrolling at the same
 * speed past a shared sync cursor, to show simultaneous, synchronized capture.
 * Pure SVG + CSS (no JS). Traces are generated at build time from each category's
 * `signal.shape`; they are illustrative, not recorded data. Static under reduced motion.
 * The categories section on the same page is the text equivalent.
 */
import type { Category } from '../lib/lab';
interface Props {
  lanes: Category[];
  label: string;
  syncLabel: string;
  liveLabel: string;
}
const { lanes, label, syncLabel, liveLabel } = Astro.props;

const W = 600; // one period in SVG units; each SVG holds two periods and scrolls by one
const H = 40;
const N = 160; // samples per period; the second period is a <use> copy

/** Deterministic pseudo-random numbers so every build draws the same traces. */
function rng(seed: number) {
  let s = seed >>> 0;
  return () => ((s = (s * 1664525 + 1013904223) >>> 0) / 2 ** 32) * 2 - 1;
}
const TAU = Math.PI * 2;

function samples(shape: string, seed: number): number[] {
  const r = rng(seed);
  const out: number[] = [];
  // Gaze: fixations joined by quick saccades.
  const fix = Array.from({ length: 9 }, () => r() * 0.8);
  for (let i = 0; i < N; i++) {
    const u = i / N;
    let y = 0;
    switch (shape) {
      case 'mocap': // smooth gait-like joint angle
        y = 0.55 * Math.sin(TAU * 5 * u) + 0.25 * Math.sin(TAU * 10 * u + 0.8) + 0.08 * Math.sin(TAU * 15 * u);
        break;
      case 'emg': { // bursts of muscle activity
        const env = Math.max(0, Math.sin(TAU * 5 * u - 0.6)) ** 3;
        y = env * r() * 0.95 + r() * 0.04;
        break;
      }
      case 'eeg':
        y = 0.3 * Math.sin(TAU * 31 * u) + 0.2 * Math.sin(TAU * 13 * u + 1.3) + 0.18 * Math.sin(TAU * 47 * u) + r() * 0.12;
        break;
      case 'gaze': {
        const k = Math.floor(u * fix.length);
        const t = u * fix.length - k;
        const a = fix[k];
        const b = fix[(k + 1) % fix.length];
        y = t < 0.88 ? a + r() * 0.03 : a + (b - a) * ((t - 0.88) / 0.12);
        break;
      }
      case 'thermal': // slow drift with breathing ripple
        y = 0.45 * Math.sin(TAU * 2 * u) + 0.15 * Math.sin(TAU * 12 * u);
        break;
      case 'rf':
        y = (0.35 + 0.45 * Math.sin(TAU * 4 * u) ** 2) * Math.sin(TAU * 60 * u);
        break;
      case 'imu': { // step impacts
        const p = (u * 8) % 1;
        y = Math.exp(-((p - 0.2) ** 2) / 0.002) * 0.85 - Math.exp(-((p - 0.3) ** 2) / 0.004) * 0.35 + r() * 0.05;
        break;
      }
      default:
        y = Math.sin(TAU * 6 * u) * 0.5;
    }
    out.push(Math.max(-1, Math.min(1, y)));
  }
  return out;
}

/** One period as a compact path (integer x, one-decimal y), closed onto its own start. */
function path(shape: string, seed: number) {
  const ys = samples(shape, seed);
  const y = (v: number) => +(H / 2 - v * (H / 2 - 3)).toFixed(1);
  const pts = ys.map((v, i) => `${Math.round((i / N) * W)} ${y(v)}`);
  pts.push(`${W} ${y(ys[0])}`);
  return 'M' + pts.join('L');
}

const rows = lanes
  .filter((c) => c.data.signal)
  .map((c, i) => ({ id: c.id, short: c.data.short, rate: c.data.signal!.rate, d: path(c.data.signal!.shape, 17 + i * 101), color: `var(--sig-${(i % 7) + 1})` }));
---
<div class="monitor" role="img" aria-label={label}>
  <div class="chrome">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="live"><span class="pulse"></span>{liveLabel}</span>
  </div>
  <div class="lanes">
    {rows.map((r) => (
      <div class="lane" style={`--c:${r.color}`}>
        <span class="name">{r.short}</span>
        <div class="trace">
          <svg viewBox={`0 0 ${2 * W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path id={`sig-${r.id}`} d={r.d} vector-effect="non-scaling-stroke" />
            <use href={`#sig-${r.id}`} x={W} />
          </svg>
        </div>
        <span class="rate">{r.rate ?? ''}</span>
      </div>
    ))}
    <span class="cursor" aria-hidden="true"></span>
  </div>
  <div class="sync">
    <span class="ticks" aria-hidden="true"></span>
    <span class="sync-label">{syncLabel}</span>
  </div>
</div>
<style>
  .monitor {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 100% 24px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 24px 100%,
      linear-gradient(180deg, color-mix(in srgb, var(--bg-raised) 92%, transparent), var(--bg));
    box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--glow) 35%, transparent), inset 0 1px 0 rgb(255 255 255 / 0.04);
    padding: var(--space-4) var(--space-5) var(--space-5);
    font-family: var(--font-mono);
    overflow: hidden;
  }
  .chrome { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .live { display: inline-flex; align-items: center; gap: 0.5em; font-size: var(--text-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-soft); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--status-installed); box-shadow: 0 0 0 0 var(--status-installed); animation: pulse 2s infinite; }

  .lanes { position: relative; display: grid; gap: 2px; }
  .lane {
    display: grid; grid-template-columns: 4.6rem 1fr 5.6rem; align-items: center; gap: var(--space-3);
    min-height: 40px; border-bottom: 1px dashed color-mix(in srgb, var(--line) 70%, transparent);
  }
  .lane:last-of-type { border-bottom: 0; }
  .name { font-size: var(--text-xs); letter-spacing: 0.1em; color: var(--c); font-weight: 600; }
  .rate { font-size: var(--text-xs); color: var(--ink-soft); text-align: right; white-space: nowrap; }
  .trace { position: relative; height: 36px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .trace svg { position: absolute; top: 0; left: 0; width: 200%; height: 100%; animation: scroll 9s linear infinite; }
  .trace path, .trace use { fill: none; stroke: var(--c); stroke-width: 1.6; stroke-linejoin: round; filter: drop-shadow(0 0 3px color-mix(in srgb, var(--c) 70%, transparent)); }
  .cursor {
    position: absolute; top: -6px; bottom: -6px; left: calc(4.6rem + var(--space-3) + (100% - 4.6rem - 5.6rem - 2 * var(--space-3)) * 0.72);
    width: 2px; background: linear-gradient(180deg, transparent, var(--accent), transparent);
    box-shadow: 0 0 12px var(--glow);
  }
  .sync { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .ticks {
    flex: 1; height: 10px; opacity: 0.8;
    background: repeating-linear-gradient(90deg, var(--accent) 0 2px, transparent 2px 24px);
    animation: tick 9s linear infinite;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .sync-label { font-size: var(--text-xs); color: var(--ink); letter-spacing: 0.04em; white-space: nowrap; }

  @keyframes scroll { to { transform: translateX(-50%); } }
  @keyframes tick { to { background-position: -600px 0; } }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--status-installed) 70%, transparent); }
    70%, 100% { box-shadow: 0 0 0 8px transparent; }
  }
  @media (max-width: 30rem) {
    .monitor { padding-inline: var(--space-4); }
    .lane { grid-template-columns: 3.8rem 1fr; }
    .rate { display: none; }
    .cursor { left: calc(3.8rem + var(--space-3) + (100% - 3.8rem - var(--space-3)) * 0.72); }
    .sync { flex-direction: column; align-items: stretch; }
    .sync-label { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trace svg, .ticks, .pulse { animation: none; }
  }
</style>
