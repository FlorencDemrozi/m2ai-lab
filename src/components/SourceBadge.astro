---
/**
 * Where an item comes from (lab-owned, PI collection, shared at UiS, via collaboration).
 * Text + shape, never colour alone; the title gives the longer explanation.
 */
import type { Source } from '../lib/lab';
import { useT, type Locale } from '../i18n/ui';
interface Props {
  source: Source;
  locale: Locale;
}
const { source, locale } = Astro.props;
const t = useT(locale);
---
<span class={`source source-${source}`} title={t(`source.hint.${source}`)}>
  <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
    {source === 'lab' && <rect x="1.5" y="1.5" width="7" height="7" rx="1" fill="currentColor" />}
    {source === 'personal' && <path d="M5 1.2 8.8 5 5 8.8 1.2 5Z" fill="none" stroke="currentColor" stroke-width="1.4" />}
    {source === 'shared-uis' && <><circle cx="3.4" cy="5" r="2.4" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="6.6" cy="5" r="2.4" fill="none" stroke="currentColor" stroke-width="1.3" /></>}
    {source === 'collaboration' && <path d="M1 5h8M5 1v8" stroke="currentColor" stroke-width="1.6" />}
  </svg>
  {t(`source.${source}`)}
</span>
<style>
  .source {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.15em 0.65em;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .source-lab { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
</style>
