---
/**
 * Compact researcher card for grids: photo (only with consent), name and role.
 * The whole card links to the researcher's page, where expertise and contact details are.
 */
import { Image } from 'astro:assets';
import type { Researcher } from '../lib/lab';
import { href, pick, type Locale } from '../i18n/ui';
interface Props {
  researcher: Researcher;
  locale: Locale;
  level?: 2 | 3;
  /** Above the fold (first row): load the photo eagerly with high priority. */
  eager?: boolean;
}
const { researcher, locale, level = 3, eager = false } = Astro.props;
const r = researcher.data;
const H = `h${level}` as 'h2' | 'h3';
const initials = r.name
  .split(/\s+/)
  .filter((w) => /^\p{Lu}/u.test(w))
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---
<article class="researcher">
  {r.photo && r.consent ? (
    <Image src={r.photo} alt="" widths={[200, 400]} sizes="(min-width: 62rem) 200px, 45vw" class="photo" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  ) : (
    <span class="photo initials" aria-hidden="true">{initials}</span>
  )}
  <H class="name"><a href={href(locale, 'researchers', researcher.id)}>{r.name}</a></H>
  {r.role && <p class="role">{pick(r.role, locale)}</p>}
</article>
<style>
  .researcher {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .researcher:hover,
  .researcher:focus-within {
    border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
    box-shadow: 0 12px 32px -16px color-mix(in srgb, var(--glow) 50%, transparent);
  }
  @media (hover: hover) { .researcher:hover { transform: translateY(-2px); } }
  .photo { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; background: var(--bg-sunken); }
  .initials {
    display: grid; place-items: center;
    background: var(--accent-soft); color: var(--ink);
    font-family: var(--font-display); font-weight: 600; font-size: var(--step-3);
  }
  .name { margin: var(--space-3) var(--space-4) var(--space-1); font-size: var(--step-0); line-height: 1.3; overflow-wrap: anywhere; }
  .name a { color: inherit; text-decoration: none; }
  .name a:hover { text-decoration: underline; }
  /* The name link covers the whole card. */
  .name a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .name a:focus-visible { outline: none; }
  .name a:focus-visible::after { outline: 3px solid var(--focus); outline-offset: 2px; }
  .role { margin: 0 var(--space-4) var(--space-4); color: var(--ink-soft); font-size: var(--step--1); }
</style>
